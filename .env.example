# Servidor
PORT=3000

# CORS (origen permitido del frontend: Vite en local o el contenedor de frontend)
CORS_ORIGIN=http://localhost:5173

# JWT (cambiar los secretos fuera de desarrollo)
JWT_SECRET=cambiar-secreto-de-acceso
JWT_REFRESH_SECRET=cambiar-secreto-de-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Base de datos (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=api_san
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Base de las pruebas e2e (opcional). Por defecto: <POSTGRES_DB>_e2e, se crea sola.
# POSTGRES_DB_E2E=api_san_e2e

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@apisan.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Frontend (http://localhost:5173)
FRONTEND_PORT=5173
