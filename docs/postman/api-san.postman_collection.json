    {
      "name": "Busquedas",
      "description": "Busqueda publica: el body usa el nombre de la carrera, no el ID",
      "item": [
        {
          "name": "Crear busqueda",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/busquedas",
            "auth": {
              "type": "noauth"
            },
