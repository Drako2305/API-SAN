  "item": [
    {
      "name": "Auth",
      "description": "Registro, login y refresh. Son publicos (noauth). El login admin debe ejecutarse antes de las escrituras del catalogo y de /usuarios.",
      "item": [
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/registro",
            "description": "Crea un usuario estudiante nuevo. No cambia las variables de sesion.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario de prueba\",\n  \"correo\": \"prueba.{{$timestamp}}@correo.com\",\n  \"clave\": \"clave12345\",\n  \"perfil\": {\n    \"apellido\": \"Prueba\",\n    \"ciudad\": \"Bogota\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Guarda accessToken, refreshToken y usuarioId (estudiante demo). Sobrescribe accessToken: despues de este login las escrituras del catalogo responden 403.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"nicolas@correo.com\",\n  \"clave\": \"12345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);",
                  "pm.collectionVariables.set(\"usuarioId\", json.data.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Guarda accessToken, refreshToken y adminUsuarioId. Ejecutar primero para las escrituras del catalogo.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@correo.com\",\n  \"clave\": \"admin12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);",
                  "pm.collectionVariables.set(\"adminUsuarioId\", json.data.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Renueva los tokens con el refreshToken guardado (el del admin).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalogo",
      "description": "Lecturas publicas y escrituras solo para admin. Las escrituras crean, modifican y eliminan registros propios (carreraNuevaId, universidadNuevaId, ofertaNuevaId) para no tocar los datos del seed.",
      "item": [
        {
          "name": "Carreras",
          "description": "CRUD de carreras",
          "item": [
            {
              "name": "Listar carreras (filtro nombre)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/carreras?nombre=Ingenieria",
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                      "const c = pm.response.json().find((x) => x.nombre === \"Ingenieria de Sistemas\");",
                      "pm.test(\"Carrera del seed encontrada\", () => pm.expect(c).to.not.be.undefined);",
                      "if (c) pm.collectionVariables.set(\"carreraId\", c.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Consultar carrera",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/carreras/{{carreraId}}",
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Crear carrera",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/carreras",
                "description": "Requiere token admin.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Carrera de prueba nueva {{$timestamp}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                      "pm.collectionVariables.set(\"carreraNuevaId\", pm.response.json().data.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Actualizar carrera (PUT)",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/carreras/{{carreraNuevaId}}",
                "description": "Requiere token admin. Actualiza la carrera creada por el POST anterior.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Carrera de prueba PUT {{$timestamp}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Actualizar carrera (PATCH)",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/carreras/{{carreraNuevaId}}",
                "description": "Requiere token admin. Mismo body que PUT.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Carrera de prueba PATCH {{$timestamp}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Eliminar carrera",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/carreras/{{carreraNuevaId}}",
                "description": "Requiere token admin. Elimina la carrera creada en esta coleccion."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            }
          ]
        },
