{
  "info": {
    "name": "API SAN",
    "description": "Pruebas de la API SAN (Sistema Academico de Navegacion). Ejecutar primero \"Auth / Login admin\" para llenar las variables de sesion. Ver README.md, seccion \"Probar con Postman\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
